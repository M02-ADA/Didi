    def Xform "EditorPreviews" (
        doc = "Editor-only stand-ins. LaserScene removes this group at runtime."
    )
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        float3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Scope "PreviewMaterials"
        {
            def Material "PlayerParent"
            {
                token outputs:mtlx:surface.connect = </Root/EditorPreviews/PreviewMaterials/PlayerParent/Unlit.outputs:out>
                token outputs:realitykit:vertex
                token outputs:surface

                def Shader "Unlit"
                {
                    uniform token info:id = "ND_realitykit_unlit_surfaceshader"
                    bool inputs:applyPostProcessToneMap = 0
                    color3f inputs:color.connect = </Root/EditorPreviews/PreviewMaterials/PlayerParent/Color.outputs:out>
                    float inputs:opacity.connect = </Root/EditorPreviews/PreviewMaterials/PlayerParent/Channels.outputs:outa>
                    token outputs:out
                }

                def Shader "Image"
                {
                    uniform token info:id = "ND_image_color4"
                    asset inputs:file = @Textures/preview_parent.png@
                    string inputs:filtertype = "linear"
                    string inputs:uaddressmode = "clamp"
                    string inputs:vaddressmode = "clamp"
                    color4f outputs:out
                }

                def Shader "Color"
                {
                    uniform token info:id = "ND_convert_color4_color3"
                    color4f inputs:in.connect = </Root/EditorPreviews/PreviewMaterials/PlayerParent/Image.outputs:out>
                    color3f outputs:out
                }

                def Shader "Channels"
                {
                    uniform token info:id = "ND_separate4_color4"
                    color4f inputs:in.connect = </Root/EditorPreviews/PreviewMaterials/PlayerParent/Image.outputs:out>
                    float outputs:outa
                }
            }

            def Material "PlayerChild"
            {
                token outputs:mtlx:surface.connect = </Root/EditorPreviews/PreviewMaterials/PlayerChild/Unlit.outputs:out>
                token outputs:realitykit:vertex
                token outputs:surface

                def Shader "Unlit"
                {
                    uniform token info:id = "ND_realitykit_unlit_surfaceshader"
                    bool inputs:applyPostProcessToneMap = 0
                    color3f inputs:color.connect = </Root/EditorPreviews/PreviewMaterials/PlayerChild/Color.outputs:out>
                    float inputs:opacity.connect = </Root/EditorPreviews/PreviewMaterials/PlayerChild/Channels.outputs:outa>
                    token outputs:out
                }

                def Shader "Image"
                {
                    uniform token info:id = "ND_image_color4"
                    asset inputs:file = @Textures/preview_child.png@
                    string inputs:filtertype = "linear"
                    string inputs:uaddressmode = "clamp"
                    string inputs:vaddressmode = "clamp"
                    color4f outputs:out
                }

                def Shader "Color"
                {
                    uniform token info:id = "ND_convert_color4_color3"
                    color4f inputs:in.connect = </Root/EditorPreviews/PreviewMaterials/PlayerChild/Image.outputs:out>
                    color3f outputs:out
                }

                def Shader "Channels"
                {
                    uniform token info:id = "ND_separate4_color4"
                    color4f inputs:in.connect = </Root/EditorPreviews/PreviewMaterials/PlayerChild/Image.outputs:out>
                    float outputs:outa
                }
            }
        }

