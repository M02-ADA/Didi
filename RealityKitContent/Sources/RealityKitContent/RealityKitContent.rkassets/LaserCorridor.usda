#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root" (
    doc = "LaserHeist corridor (LH-03), styled after Background/Asset 16."
)
{
    quatf xformOp:orient = (1, 0, 0, 0)
    float3 xformOp:scale = (1, 1, 1)
    float3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

    def Scope "Materials"
    {
        def Material "Floor"
        {
            token outputs:mtlx:surface.connect = </Root/Materials/Floor/Unlit.outputs:out>
            token outputs:realitykit:vertex
            token outputs:surface

            def Shader "Unlit"
            {
                uniform token info:id = "ND_realitykit_unlit_surfaceshader"
                bool inputs:applyPostProcessToneMap = 0
                color3f inputs:color.connect = </Root/Materials/Floor/Color.outputs:out>
                token outputs:out
            }

            def Shader "Image"
            {
                uniform token info:id = "ND_image_color4"
                asset inputs:file = @Textures/corridor_floor.png@
                string inputs:filtertype = "linear"
                string inputs:uaddressmode = "clamp"
                string inputs:vaddressmode = "clamp"
                color4f outputs:out
            }

            def Shader "Color"
            {
                uniform token info:id = "ND_convert_color4_color3"
                color4f inputs:in.connect = </Root/Materials/Floor/Image.outputs:out>
                color3f outputs:out
            }
        }

