        def Xform "LaserPreview" (
            doc = "Editor-only view of the runtime Option 1 gate. References LaserGate.usda and hides its non-active state layers here only."
            prepend references = @LaserGate.usda@
        )
        {
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (1, 1, 1)
            float3 xformOp:translate = (0, 0, 0.02)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "Gate"
            {
                over "Beam"
                {
                    float3 xformOp:scale = (2.01307, 1, 1)

                    over "Warning"
                    {
                        token visibility = "invisible"
                    }
                }

                over "EmitterLeft"
                {
                    float3 xformOp:translate = (-3.08, 0, 0)

                    over "Disabled"
                    {
                        token visibility = "invisible"
                    }

                    over "WarningRing"
                    {
                        token visibility = "invisible"
                    }

                    over "HitSpark"
                    {
                        token visibility = "invisible"
                    }
                }

                over "EmitterRight"
                {
                    float3 xformOp:translate = (3.08, 0, 0)

                    over "Disabled"
                    {
                        token visibility = "invisible"
                    }

                    over "WarningRing"
                    {
                        token visibility = "invisible"
                    }

                    over "HitSpark"
                    {
                        token visibility = "invisible"
                    }
                }
            }
        }

        def Xform "VaultDoorPreview" (
            doc = "Editor-only view of VaultDoor.usda at a sample depth, locked. The runtime places the door from game state."
            prepend references = @VaultDoor.usda@
        )
        {
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (1, 1, 1)
            float3 xformOp:translate = (0, 0, -9)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "VaultDoorRoot"
            {
                over "UnlockedLight"
                {
                    token visibility = "invisible"
                }
            }
        }

        def Xform "DiamondPreview" (
            doc = "Editor-only view of Diamond.usda at a sample wrist-height position."
            prepend references = @Diamond.usda@
        )
        {
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (1, 1, 1)
            float3 xformOp:translate = (-1.25, 1.2, -1.5)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "Diamond"
            {
                over "Sparkle"
                {
                    token visibility = "invisible"
                }
            }
        }
    }
}
