#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    def Scope "Materials"
    {
        def Material "EmitterLeft"
        {
            token outputs:mtlx:surface.connect = </Root/Materials/EmitterLeft/Unlit.outputs:out>
            token outputs:realitykit:vertex
            token outputs:surface

            def Shader "Unlit"
            {
                uniform token info:id = "ND_realitykit_unlit_surfaceshader"
                bool inputs:applyPostProcessToneMap = 0
                color3f inputs:color.connect = </Root/Materials/EmitterLeft/Color.outputs:out>
                float inputs:opacity.connect = </Root/Materials/EmitterLeft/Channels.outputs:outa>
                token outputs:out
            }

            def Shader "Image"
            {
                uniform token info:id = "ND_image_color4"
                asset inputs:file = @Textures/laser_emitter_left.png@
                string inputs:filtertype = "linear"
                string inputs:uaddressmode = "clamp"
                string inputs:vaddressmode = "clamp"
                color4f outputs:out
            }

            def Shader "Color"
            {
                uniform token info:id = "ND_convert_color4_color3"
                color4f inputs:in.connect = </Root/Materials/EmitterLeft/Image.outputs:out>
                color3f outputs:out
            }

            def Shader "Channels"
            {
                uniform token info:id = "ND_separate4_color4"
                color4f inputs:in.connect = </Root/Materials/EmitterLeft/Image.outputs:out>
                float outputs:outa
            }
        }

