+  /// The largest set of samples whose head-top, left sole and right sole each lie within the
+  /// latest sample's tolerance of one another (indices, oldest first). Ties prefer the most
+  /// recent samples. O(n³) over at most `maximumRetainedSamples` samples.
+  private static func agreeing(_ window: [PlayerSample]) -> [Int] {
+    guard let tolerance = window.last?.tolerance else { return [] }
+    let limit = tolerance + 1e-9
+    func within(_ value: Double, _ low: Double) -> Bool { value >= low && value - low <= limit }
+    var best: [Int] = [], bestRecency = -1
