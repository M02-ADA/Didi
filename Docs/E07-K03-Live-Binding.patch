+import Foundation
+import RealityKit
+import Testing
+import simd
+@testable import Sedactive
+
+/// E07 to K03 through the real gate, tracker, bridge, adapter, factory and pump,
+/// into the real mailbox, presenter and mascots. Deterministic Vision fixtures
+/// and an injected clock: no camera, so this says nothing about real tracking.
+@MainActor
+struct VisionK03IntegrationTests {
+    private struct Rig {
+        var f: TrackingIntegrationFixture
+        let bridge: VisionNumericPoseBridge
+        let scene: LaserScene
+        let mailbox: AvatarPoseMailbox
+        var nextFrame: UInt64 = 3
+        var time = 0.25
+
+        var avatars: RobotAvatarLayer { scene.robotAvatars! }
+        func robot(_ player: PlayerID) -> RobotAvatarLayer.Robot { avatars.robots[player]! }
+        func renderTick() { scene.refreshLiveAvatars(now: f.clock.time + 0.005) }
+
+        /// One camera frame through admission, tracking and publication, as the worker runs it.
+        @discardableResult
+        mutating func deliver(_ candidates: [PoseCandidate] = LiveVisionFixtures.standingPair,
+                              duringInference: () -> Void = {}) throws -> UInt64 {
+            let id = nextFrame
+            let result = try f.result(id, time, candidates)
+            f.clock.time = time
+            let admission = try #require(f.gate.admit(result.source))
+            duringInference()
+            try #require(try f.finish(result, stamp: admission))
+            f.gate.publishPresentation(result, admission: admission, receipt: try #require(f.gate.snapshot.latest))
+            nextFrame += 1
+            time += 0.125
+            return id
+        }
+    }
+
+    private func rig(boundBeforeAttach: Bool = false) async throws -> Rig {
+        var f = try TrackingIntegrationFixture()
+        let bridge = VisionNumericPoseBridge(gate: f.gate)
+        if boundBeforeAttach { try f.bind() }
+        let scene = LaserScene()
+        let mailbox = AvatarPoseMailbox(maxAge: LiveAvatarPresenter.maximumPoseAge)
+        let pump = try VisionK03MailboxPump(bridge: bridge, mailbox: mailbox)
+        scene.attachLiveAvatars(mailbox: mailbox, templates: try await RobotAvatarLayer.sharedTemplates(), pump: pump)
+        if !boundBeforeAttach { try f.bind() }
+        return Rig(f: f, bridge: bridge, scene: scene, mailbox: mailbox)
+    }
+
+    private func raised(_ candidate: PoseCandidate) -> PoseCandidate {
+        var joints = candidate.joints
+        let x = joints[.leftShoulder]!.x
+        joints[.leftWrist] = PoseJoint(x: x, y: 0.98, confidence: 0.9)
+        return PoseCandidate(candidateID: candidate.candidateID, joints: joints, maskTopImageY: nil, maskBottomImageY: nil,
+                             leftFootBottomImageY: nil, rightFootBottomImageY: nil, maskAssociation: .unavailable)
+    }
+
+    private func armY(_ robot: RobotAvatarLayer.Robot) -> Float {
+        simd_normalize(robot.retargeter.targets.upperArm[.left] ?? SIMD3(0, -1, 0)).y
+    }
+
+    private func oneMascotEach(_ scene: LaserScene) throws {
+        for player in PlayerID.allCases {
+            let entity = try #require(scene.players[player])
+            #expect(entity.children.filter { $0.name == "player.\(player.rawValue).robot" }.count == 1)
+        }
+    }
+
+    // MARK: Identity and field mapping
+
+    @Test func packetsKeepSourceIdentityPlayerSlotsAndObservedJoints() throws {
+        var f = try TrackingIntegrationFixture()
+        let bridge = VisionNumericPoseBridge(gate: f.gate)
+        let lease = try bridge.attach()
+        try f.bind()
+        var candidates = LiveVisionFixtures.standingPair
+        var joints = candidates[0].joints
+        joints.removeValue(forKey: .leftWrist)
+        joints[.rightWrist] = PoseJoint(x: 0.71, y: 0.33, confidence: 0.1)
+        candidates[0] = PoseCandidate(candidateID: 10, joints: joints, maskTopImageY: nil, maskBottomImageY: nil,
+                                      leftFootBottomImageY: nil, rightFootBottomImageY: nil, maskAssociation: .unavailable)
+        let result = try f.result(3, 0.25, candidates)
+        let admission = try #require(f.gate.admit(result.source))
+        try #require(try f.finish(result, stamp: admission))
+        f.gate.publishPresentation(result, admission: admission, receipt: try #require(f.gate.snapshot.latest))
+
+        let batch = try VisionAvatarPacketAdapter.map(try #require(bridge.drain(lease)), using: VisionK03PacketFactory.self)
+        let output = try #require(batch.output)
+        #expect(output.source.frameID == 3 && output.source.capturedAt == 0.25)
+        #expect(output.source.context == batch.status.context && output.contextRevision == batch.status.revision)
+        #expect(output.source.controlRevision == batch.status.controlRevision)
+        #expect(output.player1 == AvatarTrackedSlot(state: .tracking, candidateID: 10, requiresRebind: false))
+        #expect(output.player2 == AvatarTrackedSlot(state: .tracking, candidateID: 20, requiresRebind: false))
+        #expect(output.candidates == candidates)
+        let p1 = try #require(output.candidates.first { $0.candidateID == 10 })
+        #expect(p1.joints[.leftWrist] == nil && p1.joints[.rightWrist]?.confidence == 0.1)
+        #expect(output.calibration.isEmpty)
+    }
+
+    @Test func acceptedCalibrationIsCalibratedForThatPlayerOnlyAndCarriesNoVisualValues() throws {
+        let fixtures = VisionAvatarPacketAdapterTests()
+        let drain = try fixtures.fixture(calibration: true)
+        let batch = try VisionAvatarPacketAdapter.map(drain, using: VisionK03PacketFactory.self)
+        let mailbox = AvatarPoseMailbox(maxAge: 0.25)
+        mailbox.publish(batch.status, forceResetAll: batch.resetAll)
+        #expect(mailbox.offer(try #require(batch.output)) == nil)
+        let out = mailbox.drain(now: 0.26)
+        #expect(out.reset.all)
+        let frame = try #require(out.frame)
+        guard case .available(let p1) = frame.player1, case .calibrated(let reference, let visual) = p1.capability else {
+            Issue.record("P1 was not calibrated"); return
+        }
+        let c = try #require(drain.output?.acceptedCalibrations[.player1])
+        #expect(visual == nil && reference.calibrationRevision == c.revision)
+        guard case .available(let p2) = frame.player2 else { Issue.record("P2 not tracked"); return }
+        #expect(p2.capability == .directionOnly)
+
+        let mismatched = try VisionAvatarPacketAdapter.map(fixtures.fixture(calibration: true, mismatch: true), using: VisionK03PacketFactory.self)
+        #expect(mismatched.output?.calibration.isEmpty == true)
+    }
+
+    // MARK: Render tick
+
+    @Test func eachPlayersPacketsDriveOnlyThatMascotOnTheRenderTick() async throws {
+        var rig = try await rig()
+        for _ in 0..<12 {
+            var pair = LiveVisionFixtures.standingPair
+            pair[0] = raised(pair[0])  // candidate 10, P1
+            try rig.deliver(pair)
+            rig.renderTick()
+        }
+        #expect(rig.robot(.player1).retargeter.isAvailable && rig.robot(.player2).retargeter.isAvailable)
+        #expect(armY(rig.robot(.player1)) > 0.5, "P1 \(armY(rig.robot(.player1)))")
+        #expect(armY(rig.robot(.player2)) < 0.3, "P2 \(armY(rig.robot(.player2)))")
+        // Direction-only: no calibration was accepted, so no lift or crouch is claimed.
+        for player in PlayerID.allCases {
+            let r = rig.robot(player).retargeter
+            #expect(r.reference == nil && r.lift == 0 && r.targets.pelvisDrop == 0 && r.footDelta.isEmpty)
+            #expect(rig.robot(player).container.position.y == 0)
+        }
+        try oneMascotEach(rig.scene)
+    }
+
+    @Test func aPacketPublishedBeforeTheTickIsShownOnThatTick() async throws {
+        var rig = try await rig()
+        rig.renderTick()
+        #expect(!rig.robot(.player1).retargeter.isAvailable)
+        try rig.deliver()
+        #expect(rig.mailbox.diagnostics.accepted == 0)
+        rig.renderTick()
+        #expect(rig.mailbox.diagnostics.accepted == 1)
+        #expect(rig.robot(.player1).retargeter.isAvailable)
+    }
+
+    @Test func renderTicksBetweenCameraFramesDoNotEndTheFeed() async throws {
+        var rig = try await rig()
+        try rig.deliver()
+        for _ in 0..<6 { rig.renderTick() }
+        #expect(rig.scene.liveAvatars?.feedEnded == false && !rig.mailbox.isRevoked)
+        #expect(rig.mailbox.diagnostics.accepted == 1 && rig.mailbox.diagnostics.rejected.isEmpty)
+    }
+
+    // MARK: Loss, reset and teardown
+
+    @Test func oneLostPlayerDimsWhileThePeerContinuesThenRecovers() async throws {
+        var rig = try await rig()
+        for _ in 0..<4 { try rig.deliver(); rig.renderTick() }
+        for _ in 0..<3 { try rig.deliver([TrackingFixtures.candidate(10, x: 0.75)]); rig.renderTick() }
+        #expect(rig.robot(.player1).retargeter.isAvailable)
+        #expect(!rig.robot(.player2).retargeter.isAvailable)
+        #expect(rig.robot(.player1).container.components[OpacityComponent.self]?.opacity == 1)
+        #expect(rig.robot(.player2).container.components[OpacityComponent.self]?.opacity == RobotAvatarLayer.unavailableOpacity)
+        try oneMascotEach(rig.scene)
+        for _ in 0..<8 { try rig.deliver(); rig.renderTick() }
+        #expect(rig.robot(.player2).retargeter.isAvailable)
+        #expect(rig.mailbox.diagnostics.rejected.isEmpty)
+    }
+
+    @Test func sourceLossForgetsThePoseOnTheNextTickAndTheFeedSurvives() async throws {
+        var rig = try await rig()
+        for _ in 0..<4 { try rig.deliver(); rig.renderTick() }
+        #expect(rig.robot(.player1).retargeter.isAvailable)
+        rig.f.gate.sourceLost(rig.f.context)
+        rig.renderTick()
+        for player in PlayerID.allCases {
+            #expect(!rig.robot(player).retargeter.isAvailable)
+            #expect(rig.robot(player).container.components[OpacityComponent.self]?.opacity == RobotAvatarLayer.unavailableOpacity)
+        }
+        #expect(rig.scene.liveAvatars?.feedEnded == false && !rig.mailbox.isRevoked)
+    }
+
+    @Test func aNewCaptureContextReplacesTheOldPoseAndPacketsResume() async throws {
+        var rig = try await rig()
+        for _ in 0..<4 { try rig.deliver(); rig.renderTick() }
+        let accepted = rig.mailbox.diagnostics.accepted
+
+        let next = CameraSourceContext(generation: UUID(), epoch: UUID(), geometryRevision: 2)
+        rig.f.gate.invalidate(rig.f.context, ended: true)
+        rig.f.gate.begin(next, wake: AsyncStream<Void>.makeStream(bufferingPolicy: .bufferingNewest(1)).continuation)
+        rig.renderTick()
+        #expect(!rig.robot(.player1).retargeter.isAvailable)
+        #expect(!rig.robot(.player2).retargeter.isAvailable)
+
+        _ = try rig.f.gate.arm(request: rig.f.gate.makeBindingRequest())
+        var t = rig.time + 0.125
+        for id in UInt64(1)...5 {
+            let result = try rig.f.result(id, t, LiveVisionFixtures.standingPair, context: next)
+            rig.f.clock.time = t
+            let admission = try #require(rig.f.gate.admit(result.source))
+            try #require(try rig.f.finish(result, stamp: admission))
+            rig.f.gate.publishPresentation(result, admission: admission, receipt: try #require(rig.f.gate.snapshot.latest))
+            rig.renderTick()
+            t += 0.125
+        }
+        #expect(rig.mailbox.diagnostics.accepted > accepted)
+        #expect(rig.mailbox.diagnostics.rejected.isEmpty)
+        #expect(rig.robot(.player1).retargeter.isAvailable && rig.robot(.player2).retargeter.isAvailable)
+    }
+
+    @Test func aRetiredLeaseEndsTheFeedWithoutHoldingAPose() async throws {
+        var rig = try await rig()
+        for _ in 0..<4 { try rig.deliver(); rig.renderTick() }
+        _ = try rig.bridge.attach()   // As a session stop or a newer scene would.
+        rig.renderTick()
+        #expect(rig.scene.liveAvatars?.feedEnded == true && rig.mailbox.isRevoked)
+        for player in PlayerID.allCases {
+            #expect(!rig.robot(player).retargeter.isAvailable)
+            #expect(rig.robot(player).container.components[OpacityComponent.self]?.opacity == RobotAvatarLayer.unavailableOpacity)
+        }
+        try oneMascotEach(rig.scene)
+    }
+
+    @Test func retryAttachesAFreshLeaseAndTheOldSceneCannotCancelIt() async throws {
+        var rig = try await rig()
+        for _ in 0..<4 { try rig.deliver(); rig.renderTick() }
+
+        // The new scene attaches before the old one finishes tearing down.
+        let scene = LaserScene()
+        let mailbox = AvatarPoseMailbox(maxAge: LiveAvatarPresenter.maximumPoseAge)
+        let pump = try VisionK03MailboxPump(bridge: rig.bridge, mailbox: mailbox)
+        scene.attachLiveAvatars(mailbox: mailbox, templates: try await RobotAvatarLayer.sharedTemplates(), pump: pump)
+        rig.scene.detachLiveAvatars()
+        #expect(rig.mailbox.isRevoked && !mailbox.isRevoked)
+
+        let accepted = rig.mailbox.diagnostics.accepted
+        for _ in 0..<3 {
+            try rig.deliver()
+            scene.refreshLiveAvatars(now: rig.f.clock.time + 0.005)
+        }
+        #expect(mailbox.diagnostics.accepted > 0 && rig.mailbox.diagnostics.accepted == accepted)
+        #expect(scene.robotAvatars?.robots.values.allSatisfy { $0.retargeter.isAvailable } == true)
+        try oneMascotEach(scene)
+    }
+
+    // MARK: Known producer issue
+
+    /// The render tick runs during each frame's Vision inference, between
+    /// admission and publication. After a stall as long as the freshness limit
+    /// the channel's old `lastCapture` must not keep invalidating every frame.
+    @Test func aCameraStallDoesNotEndDeliveryForTheRestOfTheSession() async throws {
+        var rig = try await rig()
+        for _ in 0..<4 {
+            try rig.deliver { }
+            rig.renderTick()
+        }
+        let before = rig.mailbox.diagnostics.accepted
+        rig.time += 0.6   // No frame reaches the gate for longer than the policy's freshness.
+        rig.f.clock.time = rig.time
+        rig.renderTick()
+        for _ in 0..<16 {
+            let tick = rig
+            try rig.deliver(duringInference: { tick.renderTick() })
+            rig.renderTick()
+        }
+        withKnownIssue("Pending Edo: the channel's drain checks lastCapture, which only a publication can refresh") {
+            #expect(rig.mailbox.diagnostics.accepted > before)
+        }
+    }
+}
