diff --git a/SedactiveTests/Shared/BodyTrackingTests/RobustCalibrationWindowTests.swift b/SedactiveTests/Shared/BodyTrackingTests/RobustCalibrationWindowTests.swift
new file mode 100644
index 0000000..e7227cf
--- /dev/null
+++ b/SedactiveTests/Shared/BodyTrackingTests/RobustCalibrationWindowTests.swift
@@ -0,0 +1,180 @@
+import Foundation
+import Testing
+@testable import Sedactive
+
+/// StandingCollectionPolicyV1.2 (proposal): a player is stable once 8 of their latest 10 valid
+/// samples agree within the unchanged 2-mask-row tolerance, and the reference comes from those
+/// agreeing samples only. Deterministic: explicit capture/host times, the real `CalibrationSession`.
+nonisolated struct RobustCalibrationWindowTests {
+    /// The iPad's native instance-mask height: the 2-row tolerance is 2/384 of the image height.
+    static let maskRows = 384
+    static let row = 1.0 / Double(maskRows)
+    static let crown = 0.9, sole = 0.1
+
+    struct Reading {
+        var crown = RobustCalibrationWindowTests.crown
+        var leftSole = RobustCalibrationWindowTests.sole
+        var rightSole = RobustCalibrationWindowTests.sole
+        var p2Tracking = true
+        var p1Nose = true
+    }
+
+    /// One paired sample through `beginSample` + `observe`, 0.25 s after the previous one.
+    static func sample(_ i: Int, _ p1: Reading, p2: Reading = Reading(), session: inout CalibrationSession,
+                       f: TrackingIntegrationFixture, stamp: CalibrationAdmission) throws {
+        var candidates = LiveVisionFixtures.standingPair
+        if !p1.p1Nose, let index = candidates.firstIndex(where: { $0.candidateID == 10 }) {
+            var joints = candidates[index].joints; joints[.nose] = nil
+            let c = candidates[index]
+            candidates[index] = .init(candidateID: c.candidateID, joints: joints, maskTopImageY: nil, maskBottomImageY: nil,
+                leftFootBottomImageY: nil, rightFootBottomImageY: nil, maskAssociation: .unavailable)
+        }
+        let p = try f.result(UInt64(i + 3), 0.25 + Double(i) * 0.25, candidates)
+        let admitted = session.beginSample(stamp, source: p.source, at: p.source.capturedAt)
+        try #require(admitted, "sample \(i) admitted")
+        var mask = LiveVisionFixtures.mask(p)
+        mask.maskHeight = maskRows
+        for (id, region) in mask.regions {
+            let r = id == .player1 ? p1 : p2
+            mask.anatomy[id] = .init(source: p.source, controlRevision: stamp.bindingRevision, candidateID: region.candidateID,
+                crown: .init(imageY: r.crown, status: .experimental), leftSole: .init(imageY: r.leftSole, status: .experimental),
+                rightSole: .init(imageY: r.rightSole, status: .experimental))
+        }
+        var association = LiveVisionFixtures.association(p, revision: stamp.bindingRevision)
+        if !p2.p2Tracking {
+            association = .init(source: association.source, evaluatedAt: association.evaluatedAt,
+                controlRevision: association.controlRevision, player1: association.player1,
+                player2: .init(state: .lost, reason: .observationGap, candidateID: nil, cost: nil,
+                               requiresRebind: false, lastConfirmedAt: p.source.capturedAt - 0.3),
+                assignmentCount: 1, confirmedDescriptorCount: 2, provisionalDescriptorCount: 0)
+        }
+        session.observe(mask, pose: p, association: association, stamp: stamp, at: p.source.capturedAt + 0.01)
+    }
+
+    /// Feeds `p1` readings (P2 steady) until a candidate exists; returns the sample index it
+    /// appeared on, or nil.
+    static func run(_ readings: [Reading], session: inout CalibrationSession,
+                    f: TrackingIntegrationFixture, stamp: CalibrationAdmission) throws -> Int? {
+        for (i, r) in readings.enumerated() {
+            try sample(i, r, p2: Reading(p2Tracking: r.p2Tracking), session: &session, f: f, stamp: stamp)
+            if session.phase == .candidateReady { return i }
+        }
+        return nil
+    }
+
+    static func flipped(_ rows: Double = 6) -> Reading { Reading(crown: crown + rows * row) }
+
+    // MARK: Estimator jitter
+
+    /// The iPad pattern: a still player whose head-top jumps 6 rows for two samples at a time.
+    @Test func stillPlayerWithIntermittentHeadTopJumpsCalibratesFromTheAgreeingSamples() throws {
+        let (f, initial, stamp) = try LiveVisionFixtures.sessionFixture(); var session = initial
+        let readings: [Reading] = [Reading(), Reading(), Reading(), Self.flipped(), Self.flipped(),
+                                   Reading(), Reading(), Reading(), Reading(), Reading(), Reading(), Reading()]
+        let done = try Self.run(readings, session: &session, f: f, stamp: stamp)
+        #expect(done == 9, "8 agreeing of the latest 10: complete on the 10th sample, no restart")
+        let p1 = try #require(session.candidate?.players[.player1]?.anatomy)
+        #expect(abs(p1.crownY - Self.crown) < 1e-12, "the two jumps are outvoted, never averaged in")
+        #expect(abs(p1.leftSoleY - Self.sole) < 1e-12 && abs(p1.rightSoleY - Self.sole) < 1e-12)
+        #expect(session.candidate?.samples == 8)
+        #expect(session.players[.player1]?.rejected[.moving] == 2, "each jump is still reported")
+    }
+
+    @Test func progressNeverFallsBackOnASingleJump() throws {
+        let (f, initial, stamp) = try LiveVisionFixtures.sessionFixture(); var session = initial
+        for i in 0..<7 { try Self.sample(i, Reading(), session: &session, f: f, stamp: stamp) }
+        #expect(session.players[.player1]?.samples == 7)
+        try Self.sample(7, Self.flipped(), session: &session, f: f, stamp: stamp)
+        try Self.sample(8, Self.flipped(), session: &session, f: f, stamp: stamp)
+        #expect(session.players[.player1]?.samples == 7, "70 % stays 70 % (V1.1 restarted it at 2)")
+        #expect(session.phase == .collecting)
+    }
+
+    /// Jumps more often than 2 in any 10 are not tolerated: 8 of 10 is the limit, never fewer.
+    @Test func jitterAboveTwoInTenNeverCompletes() throws {
+        let (f, initial, stamp) = try LiveVisionFixtures.sessionFixture(); var session = initial
+        let readings = (0..<30).map { $0 % 3 == 2 ? Self.flipped() : Reading() }
+        #expect(try Self.run(readings, session: &session, f: f, stamp: stamp) == nil)
+        #expect((session.players[.player1]?.samples ?? 0) < StandingCollectionPolicyV1.requiredAgreeing)
+    }
+
+    // MARK: Real movement
+
+    /// A player who keeps drifting (0.6 of the tolerance per sample) never forms a majority.
+    @Test func sustainedMovementNeverCompletes() throws {
+        let (f, initial, stamp) = try LiveVisionFixtures.sessionFixture(); var session = initial
+        let readings = (0..<30).map { i in
+            Reading(crown: Self.crown - Double(i) * 1.2 * Self.row, leftSole: Self.sole - Double(i) * 1.2 * Self.row,
+                    rightSole: Self.sole - Double(i) * 1.2 * Self.row)
+        }
+        #expect(try Self.run(readings, session: &session, f: f, stamp: stamp) == nil)
+        #expect((session.players[.player1]?.samples ?? 0) <= 2)
+        #expect((session.players[.player1]?.rejected[.moving] ?? 0) > 20)
+    }
+
+    /// A step to a new place: the old position never mixes with the new one; the reference is
+    /// taken only once 8 samples agree at the new position.
+    @Test func aStepToANewPlaceCalibratesOnlyAtTheNewPlace() throws {
+        let (f, initial, stamp) = try LiveVisionFixtures.sessionFixture(); var session = initial
+        let stepped = Reading(crown: Self.crown - 8 * Self.row, leftSole: Self.sole - 8 * Self.row,
+                              rightSole: Self.sole - 8 * Self.row)
+        let readings = Array(repeating: Reading(), count: 6) + Array(repeating: stepped, count: 10)
+        let done = try #require(try Self.run(readings, session: &session, f: f, stamp: stamp))
+        #expect(done == 6 + 7, "8 samples at the new place")
+        let p1 = try #require(session.candidate?.players[.player1]?.anatomy)
+        #expect(abs(p1.crownY - stepped.crown) < 1e-12 && abs(p1.leftSoleY - stepped.leftSole) < 1e-12)
+    }
+
+    /// Jitter inside the unchanged tolerance is averaged exactly as before; a reading outside it
+    /// is excluded rather than widening the reference.
+    @Test func accuracyIsTheSameToleranceAsBefore() throws {
+        let (f, initial, stamp) = try LiveVisionFixtures.sessionFixture(); var session = initial
+        let readings = (0..<10).map { i in Reading(crown: Self.crown + (i % 2 == 0 ? 0 : 2 * Self.row)) }
+        #expect(try Self.run(readings, session: &session, f: f, stamp: stamp) == 7, "all agree: 8 samples")
+        let crown = try #require(session.candidate?.players[.player1]?.anatomy?.crownY)
+        #expect(abs(crown - (Self.crown + Self.row)) < 1e-12, "the mean of the readings within 2 rows")
+        // Just outside the tolerance (2 rows + one hundredth): the pair cannot both count.
+        var second = initial
+        let wide = (0..<12).map { i in Reading(crown: Self.crown + (i % 2 == 0 ? 0 : 2.01 * Self.row)) }
+        #expect(try Self.run(wide, session: &second, f: f, stamp: stamp) == nil)
+    }
+
+    // MARK: Existing safety checks
+
+    /// Identity loss for one player restarts that player's window only (unchanged), and an
+    /// invalid sample (no face) is skipped, never counted.
+    @Test func invalidTrackingAndInvalidLandmarksNeverCount() throws {
+        let (f, initial, stamp) = try LiveVisionFixtures.sessionFixture(); var session = initial
+        var readings = Array(repeating: Reading(), count: 7)
+        readings.append(Reading(p2Tracking: false)) // P2 lost on sample 7
+        readings.append(contentsOf: Array(repeating: Reading(), count: 10))
+        let done = try #require(try Self.run(readings, session: &session, f: f, stamp: stamp))
+        #expect(done == 7 + 8, "P2 starts again after the identity failure and needs 8 fresh samples")
+        #expect(session.players[.player2]?.rejected[.trackingLost] == 1)
+        var noFace = initial
+        let faceless = Array(repeating: Reading(), count: 4) + Array(repeating: Reading(p1Nose: false), count: 6)
+            + Array(repeating: Reading(), count: 4)
+        #expect(try Self.run(faceless, session: &noFace, f: f, stamp: stamp) == 13, "only the 8 valid samples count")
+        #expect(noFace.players[.player1]?.rejected[.faceNotVisible] == 6)
+    }
+
+    // MARK: Repeated sessions
+
+    @Test func repeatedCalibrationSessionsStartEmptyAndCalibrateTheSameWay() throws {
+        let (f, initial, stamp) = try LiveVisionFixtures.sessionFixture(); var session = initial
+        let readings = [Reading(), Self.flipped()] + Array(repeating: Reading(), count: 9)
+        #expect(try Self.run(readings, session: &session, f: f, stamp: stamp) == 8)
+        session.consumed()
+        for round in 2...3 {
+            session.resetForNewSession()
+            #expect(session.count == 0 && session.players.isEmpty, "round \(round) starts empty")
+            let request = try #require(f.gate.snapshot.requestID)
